# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eve_healthcare?schema=public

# JWT
JWT_SECRET=your-jwt-secret-change-me
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# Webhook
WEBHOOK_SECRET=your-webhook-secret-change-me

# Redis (optional — set to false to run without Redis)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Cache
CACHE_TTL_SECONDS=60

# Booking maintenance
BOOKING_PENDING_TTL_MINUTES=30

# Worker
WORKER_CONCURRENCY=5

# Test mode (deterministic payment outcome: SUCCESS or FAILED)
# Leave empty for random simulation in production
PAYMENT_TEST_OUTCOME=
